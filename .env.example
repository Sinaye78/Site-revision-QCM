# Modèle public : aucun identifiant ni secret actif.
# npm run setup crée .env.local avec un secret aléatoire.
SITE_URL=http://localhost:3000
AUTH_SECRET=

# Démo sans génération réelle. Mettre 0 après configuration d’une IA.
IA_DEMO=1
SANS_COMPTE=1
INVITE_QCM_PAR_JOUR=10

# Connexions facultatives. * autorise tous les e-mails vérifiés.
# Vide = aucun compte externe autorisé ; liste possible séparée par virgules.
COMPTES_AUTORISES=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sous-dossier facultatif, figé lors de la compilation.
BASE_PATH=
# Par défaut ./data ; ne pas publier les données.
DATA_DIR=

# Télécharger les modèles séparément avant de désactiver la démo.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_QCM_MODEL=qwen3:4b
OLLAMA_DELAI_MS=900000

# Ordre du mode Rapide ; les fournisseurs sans clé sont ignorés.
IA_ORDRE=gemini,grok,mistral,groq,cloudflare,ollama
GEMINI_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Variables de modèles facultatives ; vides = valeurs par défaut du code.
GEMINI_MODEL=
GROK_MODEL=
MISTRAL_MODEL=
GROQ_MODEL=
CLOUDFLARE_AI_MODEL=

# Fournisseur compatible OpenAI facultatif ; ajouter compat à IA_ORDRE.
IA_COMPAT_URL=
IA_COMPAT_MODEL=
IA_COMPAT_KEY=
IA_COMPAT_VISION=0
